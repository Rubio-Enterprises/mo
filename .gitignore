.worktrees/
internal/static/dist/**/*
internal/frontend/CREDITS_FRONTEND
coverage.out
mo
e2e/node_modules
e2e/test-results
e2e/playwright-report


.DS_Store
.envrc.local
# .mise.local.toml stays trackable for committed repository tools, tasks and env
# Use .envrc.local for machine-local values
*.log
node_modules/
dist/
build/
coverage/
reports/

# .claude/: only the committed settings and hooks/commands/agents; the leading negation
# re-includes the directory under a global .claude ignore.
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
!.claude/agents/

# Per-stack
.next/
.vite/
.turbo/
.tsbuildinfo
vendor/
*.exe
*.test
*.out

# Keep the committed agent skills (.claude/skills/run-mo/) trackable. Must come
# after the .claude/* rule above.
!.claude/skills/

# Keep the placeholder for `internal/static/dist/` so `//go:embed all:dist` in
# internal/static/static.go matches at least one file before `go generate`
# runs. Must come after the `dist/` rule above (which ignores `dist/`
# anywhere); gitignore requires re-allowing the directory before re-allowing
# a file inside it. The real frontend bundle is still gitignored via the
# `internal/static/dist/**/*` rule near the top of this file.
!internal/static/dist/
!internal/static/dist/.gitkeep
.standards/
lefthook-local.yml
