{
  "name": "mo",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "dev",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "fly-durable": {
      "setupHosts": [
        "dl.google.com",
        "proxy.golang.org",
        "storage.googleapis.com",
        "sum.golang.org"
      ]
    }
  }
}
